---
import LegalDocument from '~/components/site/LegalDocument.astro';
import { getLegalForScope } from '~/utils/apps';
import { siteConfig } from '~/config/site';

/** The site-wide privacy document, at its permanent address. */
const siblings = await getLegalForScope('site');
const doc = siblings.find(
  (r) => r.kind === 'privacy' && r.locale === siteConfig.defaultLocale,
);

if (!doc) {
  throw new Error(
    'Missing src/content/legal/site/privacy.' + siteConfig.defaultLocale + '.md. ' +
      'Either add it or remove src/pages/privacy.astro.',
  );
}
---

<LegalDocument doc={doc} siblings={siblings} />
