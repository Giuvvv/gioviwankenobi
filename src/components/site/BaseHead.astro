---
import { siteConfig } from '~/config/site';
import { asset } from '~/utils/paths';

export interface Props {
  title: string;
  description?: string;
  /** Path under /public for the social preview image. */
  ogImage?: string;
  /** "website" for pages, "article" for legal documents. */
  ogType?: 'website' | 'article';
  /** Set true on pages that should not be indexed. */
  noindex?: boolean;
  /** JSON-LD objects. Only pass schemas whose data actually exists. */
  schema?: Record<string, unknown>[];
  /** BCP 47 tag for this document. Defaults to the site locale. */
  locale?: string;
}

const {
  title,
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
  ogType = 'website',
  noindex = false,
  schema = [],
  locale = siteConfig.defaultLocale,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL(asset(ogImage), Astro.site ?? Astro.url.origin);
/*
 * The home page passes the site name as its title, and a bare "gioviwankenobi"
 * in a search result says nothing to anyone who does not already know it. Every
 * other page carries the name as the suffix instead, so the brand is in both
 * without ever being repeated.
 */
const fullTitle =
  title === siteConfig.name
    ? `${title} - ${siteConfig.titleSuffix}`
    : `${title} - ${siteConfig.name}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, follow" />}

<link rel="icon" href={asset('/brand/favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={asset('/brand/apple-touch-icon.png')} />
<link rel="sitemap" href={asset('/sitemap-index.xml')} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={socialImage.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={locale.replace('-', '_')} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage.href} />

<meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0c0d0e" media="(prefers-color-scheme: dark)" />

{
  schema.map((item) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />
  ))
}
